# Copy this file to ".env" and edit the values. NEVER commit ".env".

# "local" = laptop development, "production" = deployed on EC2
APP_ENV=local

# Used to sign session cookies. In production use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# ---- Backends: local mode needs no AWS account ----
# STORAGE_BACKEND: local | s3        DB_BACKEND: local | dynamodb
# (In production these default to s3 and dynamodb, and local is refused.)
STORAGE_BACKEND=local
DB_BACKEND=local
LOCAL_DATA_DIR=local_data

# ---- AWS settings (used when backends are s3 / dynamodb) ----
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-globally-unique-bucket-name
DYNAMODB_USERS_TABLE=notes_platform_users
DYNAMODB_RESOURCES_TABLE=notes_platform_resources
# No AWS keys here. On EC2 the IAM role supplies credentials automatically.

# ---- Uploads ----
MAX_UPLOAD_MB=20
PRESIGNED_URL_EXPIRY_SECONDS=300

# ---- Authentication ----
MIN_PASSWORD_LENGTH=8
SESSION_LIFETIME_HOURS=8
# Leave empty to allow any email, or restrict sign-up, e.g. college.edu
ALLOWED_EMAIL_DOMAIN=
# Set to true only once the site is served over HTTPS
SESSION_COOKIE_SECURE=false
